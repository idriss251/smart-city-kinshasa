@startuml SmartCity_ActivityDiagram

skinparam activity {
  BackgroundColor #FEFECE
  BorderColor #000000
  ArrowColor #000000
}
skinparam shadowing false

start

:Connexion Utilisateur;

if (Authentification réussie?) then (non)
  :Afficher erreur;
  stop
else (oui)
  :Afficher Dashboard;
endif

fork
  :Signalement Citoyen;
  
  :Citoyen clique "Signaler";
  :Formulaire s'affiche;
  :Citoyen remplit formulaire;
  
  if (Type d'incident?) then (Déchets)
    :Soumettre à Waste Service;
    :Créer signalement déchets;
  elseif (Routes)
    :Soumettre à Road Service;
    :Créer problème routier;
  elseif (Inondations)
    :Soumettre à Flood Service;
    :Créer alerte inondation;
  endif
  
  :Enregistrer en base de données;
  :Envoyer confirmation;
  :Notifier agents concernés;
  
fork again
  :Intervention Agent;
  
  :Agent consulte tableau de bord;
  :Liste interventions assignées;
  
  if (Intervention urgente?) then (oui)
    :Prioriser intervention;
    :Agent se rend sur site;
    :Évaluer situation;
    :Exécuter intervention;
    :Mettre à jour statut;
    :Générer rapport;
  else (non)
    :Planifier intervention;
    :Attendre créneau disponible;
  endif
  
fork again
  :Surveillance Inondations;
  
  :Capteurs IoT mesurent niveau;
  :Transmettre données à Flood Service;
  
  if (Niveau > seuil critique?) then (critique)
    :Générer alerte urgente;
    :Notifier citoyens zone;
    :Déployer équipes secours;
  elseif (Niveau > seuil warning?) then (warning)
    :Générer alerte modérée;
    :Surveillance renforcée;
  else (normal)
    :Surveillance normale;
  endif
  
  :Enregistrer mesure historique;
  :Calculer tendance;
  
fork again
  :Collecte Déchets;
  
  :Surveiller niveau poubelles;
  
  if (Niveau > 90%?) then (critique)
    :Marquer comme critique;
    :Planifier collecte urgente;
  elseif (Niveau > 70%) then (warning)
    :Marquer comme warning;
    :Planifier collecte prochaine;
  else (normal)
    :Statut normal;
  endif
  
  :Agent effectue collecte;
  :Enregistrer volume collecté;
  :Mettre à jour niveau poubelle;
  :Calculer statistiques quotidiennes;
  
fork again
  :Dashboard Temps Réel;
  
  :Agréger données services;
  :Calculer statistiques 24h;
  :Générer graphiques;
  :Mettre à jour cartes;
  
  repeat
    :Rafraîchir données;
  repeat while (Système actif)
  
end fork

:Afficher résultats sur Dashboard;

if (Nouvelle alerte?) then (oui)
  :Afficher notification;
  :Envoyer SMS/Email;
endif

stop

note
  Surveillance Inondations :
  - Surveillance continue
  - Capteurs IoT
  - Alertes automatiques
end note

note
  Collecte Déchets :
  - Optimisation tournées
  - Prévision volumes
  - Réduction coûts
end note

note
  Dashboard Temps Réel :
  - Mise à jour automatique
  - Données horaires
  - Visualisation interactive
end note

@enduml
